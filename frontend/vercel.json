{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tappis.vercel.app/api/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "https://tappis.vercel.app/oauth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
